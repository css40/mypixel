# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# Obligatoria en producción: cadena larga y aleatoria
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Desarrollo local: déjala comentada para usar SQLite (instance/mypixel.db).
# PostgreSQL: postgresql://usuario:clave@host:5432/basedatos
# DATABASE_URL=

# Opcional: development | production (si no se define, se deduce de DATABASE_URL)
# APP_ENV=development

# Cuenta de administrador: se crea sola al arrancar SOLO si defines ADMIN_PASSWORD
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mypixel.com
# ADMIN_PASSWORD=pon-aqui-una-contraseña-larga
