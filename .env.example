# ======================  MyPixel · variables de entorno  ======================
# Copia este archivo a ".env" y ajusta los valores.

SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# ---------------------------  BASE DE DATOS  ---------------------------
# LOCAL (por defecto): deja DATABASE_URL vacía o comentada y se usa SQLite
# en instance/mypixel.db.
#
# RENDER: para probar en tu PC contra la base de datos de Render, pega aquí la
# "External Database URL" (Render > tu base de datos > Connections).
# Para volver a la base local, vuelve a comentar la línea.
#
# DATABASE_URL=postgresql://USUARIO:CLAVE@dpg-xxxxxxxx-a.oregon-postgres.render.com/mypixel

# ---------------------------  CUENTA ADMIN  ----------------------------
# Se crea sola al arrancar si todavía no existe ningún admin.
# Se inicia sesión con el CORREO y la contraseña.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mypixel.com
ADMIN_PASSWORD=Admin#MyPixel2026
